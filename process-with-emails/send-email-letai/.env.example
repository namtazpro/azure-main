# App registration (Microsoft Entra) with the Mail.Send application permission granted.
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=your-client-secret

# Mailbox that sends the message (UPN or object id).
SENDER_MAILBOX=sender@contoso.com

# Where the test message is delivered.
RECIPIENT_ADDRESS=recipient@example.com

# Optional. A new GUID is generated when this is omitted.
LETAI_REQUEST_ID=
