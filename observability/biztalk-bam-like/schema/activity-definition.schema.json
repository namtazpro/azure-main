{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-bam/schemas/activity-definition/v1",
  "title": "BAM Activity Definition",
  "description": "Defines a business activity with milestones, data items, and views for Agentic BAM",
  "type": "object",
  "required": ["activity", "version", "milestones", "correlation"],
  "properties": {
    "activity": {
      "type": "string",
      "description": "Name of the business activity (e.g., 'SalesOrder', 'InsuranceClaim')"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Schema version for this activity definition"
    },
    "description": {
      "type": "string",
      "description": "Business-friendly description of what this activity represents"
    },
    "owner": {
      "type": "string",
      "description": "Business team or person who owns this activity definition"
    },
    "correlation": {
      "type": "object",
      "required": ["division_source", "object_type", "object_id_source"],
      "properties": {
        "division_source": {
          "type": "string",
          "description": "JSONPath or field reference to extract the business division"
        },
        "object_type": {
          "type": "string",
          "description": "Fixed object type code for this activity (e.g., 'SO', 'CLM')"
        },
        "object_id_source": {
          "type": "string",
          "description": "JSONPath or field reference to extract the business object ID"
        }
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Milestone name (PascalCase)"
          },
          "description": {
            "type": "string",
            "description": "Business-friendly description"
          },
          "terminal": {
            "type": "boolean",
            "default": false,
            "description": "If true, reaching this milestone archives the activity to Completed"
          },
          "sla": {
            "type": "object",
            "properties": {
              "max_duration_from_previous": {
                "type": "string",
                "description": "ISO 8601 duration. Alert if exceeded. E.g., 'PT5M' = 5 minutes"
              },
              "max_duration_from_start": {
                "type": "string",
                "description": "ISO 8601 duration from activity start. E.g., 'PT1H' = 1 hour"
              }
            }
          }
        }
      }
    },
    "data_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Data item name"
          },
          "type": {
            "type": "string",
            "enum": ["string", "integer", "decimal", "boolean", "datetime"]
          },
          "captured_at": {
            "type": "string",
            "description": "Milestone name where this data item is first captured"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "visible_milestones", "visible_data"],
        "properties": {
          "name": {
            "type": "string",
            "description": "View name"
          },
          "description": {
            "type": "string",
            "description": "Who this view is for"
          },
          "visible_milestones": {
            "type": "array",
            "items": { "type": "string" }
          },
          "visible_data": {
            "type": "array",
            "items": { "type": "string" }
          },
          "aggregations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type", "field"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string", "enum": ["count", "avg_duration", "sum", "min", "max"] },
                "field": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "related_activities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["activity", "relationship", "link_field"],
        "properties": {
          "activity": { "type": "string", "description": "Name of the related activity" },
          "relationship": { "type": "string", "enum": ["spawns", "continues_as", "references"] },
          "link_field": { "type": "string", "description": "Field used to link to parent correlation token" }
        }
      }
    }
  }
}
