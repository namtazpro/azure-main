      "get": {
        "tags": [
          "reports"
        ],
        "summary": "Get SLA breaches",
        "description": "Lists open tickets that are past their SLA due date, most critical and most overdue first.",
        "operationId": "getSlaBreaches",
        "parameters": [
          {
            "name": "priority",
            "in": "query",
            "description": "Critical, High, Medium or Low.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "top",
            "in": "query",
            "description": "Maximum results (1-100). Default 25.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
