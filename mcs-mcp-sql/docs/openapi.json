  "paths": {
    "/customers": {
      "get": {
        "tags": [
          "customers"
        ],
        "summary": "Search customers",
        "description": "Finds customers by name prefix, exact email or company prefix and returns their open ticket count.",
        "operationId": "searchCustomers",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "description": "Customer name starts with.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "email",
            "in": "query",
            "description": "Exact customer email.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "company",
            "in": "query",
            "description": "Company name starts with.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "top",
            "in": "query",
            "description": "Maximum results (1-100). Default 20.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching customers.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/customer"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "function_key": []
          }
        ]
      }
    },
    "/customers/{customerId}/tickets": {
      "get": {
        "tags": [
          "customers"
        ],
        "summary": "Get tickets of a customer",
        "description": "Returns the most recent tickets raised by a customer, optionally filtered by status.",
        "operationId": "getCustomerTickets",
        "parameters": [
          {
            "name": "customerId",
            "in": "path",
            "description": "Customer id.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "New, Open, InProgress, Pending, Resolved or Closed.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "top",
            "in": "query",
            "description": "Maximum results (1-100). Default 25.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The customer's tickets.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/customerTicket"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Customer not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "function_key": []
          }
        ]
      }
    },
    "/agents/workload": {
      "get": {
        "tags": [
          "agents"
        ],
        "summary": "Get agent workload",
        "description": "Returns open, critical, high-priority and overdue ticket counts per support agent, optionally for one agent or team.",
        "operationId": "getAgentWorkload",
        "parameters": [
          {
            "name": "agentId",
            "in": "query",
            "description": "Agent id.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "team",
            "in": "query",
            "description": "Team name: Service Desk, Network Operations, Infrastructure, Security Operations or Application Support.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Workload per agent, busiest first.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/agentWorkload"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "function_key": []
          }
        ]
      }
