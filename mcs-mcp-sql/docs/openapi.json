    "/tickets/{ticketNumber}": {
      "get": {
        "tags": [
          "tickets"
        ],
        "summary": "Get a ticket by number",
        "description": "Returns full details of one IT support ticket, including status, priority, customer, assigned agent and SLA due date.",
        "operationId": "getTicket",
        "parameters": [
          {
            "name": "ticketNumber",
            "in": "path",
            "description": "Ticket number, for example INC-000123.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The ticket.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ticketDetail"
                }
              }
            }
          },
          "404": {
            "description": "Ticket not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "function_key": []
          }
        ]
      }
    },
    "/tickets": {
      "get": {
        "tags": [
          "tickets"
        ],
        "summary": "Search tickets",
        "description": "Searches IT support tickets with optional filters and paging (newest first, max 100 per page). Returns total count and the requested page.",
        "operationId": "searchTickets",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "New, Open, InProgress, Pending, Resolved or Closed.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "priority",
            "in": "query",
            "description": "Critical, High, Medium or Low.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "Exact category name, for example 'Network & VPN'.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "assignedAgentId",
            "in": "query",
            "description": "Agent id the ticket is assigned to.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "customerId",
            "in": "query",
            "description": "Customer id.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "createdFrom",
            "in": "query",
            "description": "Created on or after this UTC date (yyyy-MM-dd).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "createdTo",
            "in": "query",
            "description": "Created before this UTC date (yyyy-MM-dd).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "searchText",
            "in": "query",
            "description": "Text contained in the ticket title.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "overdueOnly",
            "in": "query",
            "description": "Only open tickets past their SLA due date.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "description": "1-based page number. Default 1.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Page size 1-100. Default 20.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of tickets.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ticketPage"
                }
              }
            }
          }
        },
        "security": [
          {
            "function_key": []
          }
        ]
      },
      "post": {
        "tags": [
          "tickets"
        ],
        "summary": "Create a ticket",
        "description": "Creates a new IT support ticket for a customer. The ticket starts in status New with an SLA due date based on priority.",
        "operationId": "createTicket",
        "requestBody": {
          "description": "The ticket to create.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/createTicketRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The created ticket.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ticketDetail"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Customer not found.",
