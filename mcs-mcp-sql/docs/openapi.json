    "/reports/summary": {
      "get": {
        "tags": [
          "reports"
        ],
        "summary": "Get ticket summary report",
        "description": "Returns ticket counts and average resolution hours grouped by status, priority and category for a date range (default last 30 days).",
        "operationId": "getTicketSummary",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "description": "Start UTC date (yyyy-MM-dd).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "End UTC date, exclusive (yyyy-MM-dd).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "team",
            "in": "query",
            "description": "Restrict to tickets assigned to this team.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Summary rows by dimension.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/summaryRow"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "function_key": []
          }
        ]
      }
    },
