{
  "openapi": "3.0.1",
  "info": {
    "title": "IT Service Desk API",
    "description": "Search and manage IT support tickets, customers, agents and SLA reports.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://func-ib5jb7jdzcyn6.azurewebsites.net/api"
    }
